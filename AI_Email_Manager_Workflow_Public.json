{
  "name": "AI Email Manager",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "simple": false,
        "filters": {
          "q": "in:inbox -subject:\"[Important Email]\"",
          "readStatus": "unread"
        },
        "options": {}
      },
      "id": "3a431b4b-6074-4443-8ac2-f69ec80c736a",
      "name": "New Email Received",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        112
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "messageId",
              "value": "={{ $json.id }}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "senderName",
              "value": "={{ $json.from?.value?.[0]?.name || \"\" }}",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "senderEmail",
              "value": "={{ $json.from?.value?.[0]?.address || \"\" }}",
              "type": "string"
            },
            {
              "id": "a4",
              "name": "subject",
              "value": "={{ $json.subject || \"(no subject)\" }}",
              "type": "string"
            },
            {
              "id": "a5",
              "name": "receivedAt",
              "value": "={{ $json.date }}",
              "type": "string"
            },
            {
              "id": "a6",
              "name": "body",
              "value": "={{ ($json.text || \"\").slice(0, 4000) }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "fc57cb63-5cbe-4879-8c5b-918a005def69",
      "name": "Extract Sender & Subject",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        224,
        112
      ]
    },
    {
      "parameters": {
        "text": "=From: {{ $json.senderName }} <{{ $json.senderEmail }}>\nSubject: {{ $json.subject }}\n\n{{ $json.body }}",
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"properties\":{\"category\":{\"type\":\"string\",\"enum\":[\"Important\",\"Personal\",\"Promotional\",\"Spam\"],\"description\":\"Important = work, deadlines, finance, accounts or anything needing action soon. Personal = friends and family. Promotional = marketing, newsletters, offers. Spam = unsolicited, suspicious or phishing.\"},\"summary\":{\"type\":\"string\",\"description\":\"A short 1-2 sentence summary of the email.\"}},\"required\":[\"category\",\"summary\"]}",
        "options": {
          "systemPromptTemplate": "You are an email assistant. Classify the email into exactly one category (Important, Personal, Promotional, Spam) and write a short, neutral summary of 1-2 sentences."
        }
      },
      "id": "29763091-ac22-4ed7-8fec-596282482b69",
      "name": "AI Categorize & Summarize",
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1.2,
      "position": [
        448,
        112
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5.4-mini",
          "cachedResultName": "gpt-5.4-mini"
        },
        "builtInTools": {},
        "options": {}
      },
      "id": "5d8bf7af-9e6e-46bd-835f-2e0049f68811",
      "name": "AI Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        528,
        336
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": "YOUR_GOOGLE_SHEET_ID",
          "cachedResultName": "Your Google Sheet"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Sheet1"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Date": "={{ $(\"Extract Sender & Subject\").item.json.receivedAt }}",
            "Sender": "={{ $(\"Extract Sender & Subject\").item.json.senderName }} <{{ $(\"Extract Sender & Subject\").item.json.senderEmail }}>",
            "Subject": "={{ $(\"Extract Sender & Subject\").item.json.subject }}",
            "Category": "={{ $json.output.category }}",
            "Summary": "={{ $json.output.summary }}"
          },
          "schema": [
            {
              "id": "Date",
              "displayName": "Date",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "Sender",
              "displayName": "Sender",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "Subject",
              "displayName": "Subject",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "Category",
              "displayName": "Category",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "Summary",
              "displayName": "Summary",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            }
          ]
        },
        "options": {}
      },
      "id": "725185b5-a29a-4ae5-8fa8-052df845e036",
      "name": "Save to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        800,
        112
      ]
    },
    {
      "parameters": {
        "operation": "markAsRead",
        "messageId": "={{ $(\"Extract Sender & Subject\").item.json.messageId }}"
      },
      "id": "a7c2fc22-0355-4d85-91d3-f8a3d245a898",
      "name": "Mark Email as Processed",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        1024,
        112
      ]
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $(\"AI Categorize & Summarize\").item.json.output.category }}",
              "rightValue": "Important",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "4978b65b-6c82-4dae-b331-a97c7f82378f",
      "name": "Is It Important?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1248,
        112
      ]
    },
    {
      "parameters": {
        "sendTo": "YOUR_EMAIL_ADDRESS",
        "subject": "=[Important Email] {{ $(\"Extract Sender & Subject\").item.json.subject }}",
        "emailType": "text",
        "message": "=You received an important email.\n\nFrom: {{ $(\"Extract Sender & Subject\").item.json.senderName }} <{{ $(\"Extract Sender & Subject\").item.json.senderEmail }}>\nSubject: {{ $(\"Extract Sender & Subject\").item.json.subject }}\n\nSummary: {{ $(\"AI Categorize & Summarize\").item.json.output.summary }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "1d0cb9dc-0a23-4872-9cf7-da7e42544c32",
      "name": "Send Important Email Alert",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        1472,
        112
      ]
    }
  ],
